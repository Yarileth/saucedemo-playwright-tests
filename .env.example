# Copiar como .env solo si necesitás sobrescribir los valores por defecto.

# Sitio bajo prueba
BASE_URL=https://www.saucedemo.com

# Techo de regresion (ms) para el caso TC-09 (performance_glitch_user).
# No es "lo que deberia tardar": es el limite por encima del cual la demora
# conocida (~5s) pasa a considerarse una regresion.
PERF_THRESHOLD_MS=20000
